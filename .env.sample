# Yeastar API: use PBX IP:port if VPS can securely reach it, or configured Yeastar FQDN.
# Example LAN URL: https://192.168.110.251:8088
# Example remote URL: https://nirvanaafrica.ras.yeastar.com
YEASTAR_BASE_URL=https://nirvanaafrica.ras.yeastar.com
YEASTAR_CDR_API_VERSION=v2.0
YEASTAR_AUTH_API_VERSION=v1.0
YEASTAR_TIME_FORMAT=%m/%d/%Y %H:%M:%S
TIMEZONE=Africa/Nairobi
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=
YEASTAR_VERIFY_TLS=true
YEASTAR_PAGE_SIZE=10000

# SMTP settings for the organization's approved mail server.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=info@nirvanaafrica.co.ke
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=
EMAIL_CC=

# Replace example extensions/queues/ring groups with the actual PBX identifiers.
# Use exact queue/ring-group names or numbers as shown in CDR records.
DEPARTMENT_MAP_JSON={"Customer Experience":{"extensions":["1030","1032","1043","1047","1049","1073"],"queues":[""],"ring_groups":[""]},"Collections":{"extensions":["1012","1013","1014","1015","1016","1017","1018","1054"],"queues":[""],"ring_groups":["6300"]},"Credit":{"extensions":["1019","1020","1021"],"queues":[""],"ring_groups":["6301"]},"Business Development":{"extensions":["1033","1034","1035","1036","1037","1038","1039","1040","1041","1042","1044","1046","1048","1051","1052","1053","1056"],"queues":[""],"ring_groups":["6303","6304","6305","6306"]}}

# Suggested initial KPI thresholds (confirm with department heads).
SLA_ANSWER_SECONDS=20
SLA_CALLBACK_HOURS=4
SLA_ESCALATION_HOURS=4
LOG_LEVEL=INFO
